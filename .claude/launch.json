{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portal",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path');const T={'.html':'text/html;charset=utf-8','.css':'text/css','.js':'text/javascript','.pdf':'application/pdf','.mp4':'video/mp4','.m4a':'audio/mp4','.vtt':'text/vtt'};h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/index.html';const fp=p.join(process.cwd(),u);f.readFile(fp,(e,d)=>{if(e){r.writeHead(404);r.end('no');return}r.writeHead(200,{'Content-Type':T[p.extname(fp)]||'application/octet-stream'});r.end(d)})}).listen(8123)"
      ],
      "port": 8123
    }
  ]
}